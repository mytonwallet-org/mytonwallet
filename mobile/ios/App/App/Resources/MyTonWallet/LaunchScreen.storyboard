<?xml version="1.0" encoding="UTF-8"?>
<!--
  Launch screen continued by LaunchSplash (AirAsFramework/Root/LaunchSplash.swift).
  The logo square (width = screen width) is centered; the left strip continues down to the
  bottom edge and the right strip up to the top edge.
  Images are generated by Air/scripts/launch_splash/make_launch_splash_assets.sh.
  Strip extensions: width 80/512 of the screen; centerX 150/256 (left) and 366/256 (right)
  of the screen centerX, in icon units.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="LSc-Vc-001">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="LSc-Sc-001">
            <objects>
                <viewController id="LSc-Vc-001" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="LSc-Vw-001">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" image="LaunchBackgroundGradient" translatesAutoresizingMaskIntoConstraints="NO" id="LSc-Bg-001"/>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" image="LaunchStripExtension" translatesAutoresizingMaskIntoConstraints="NO" id="LSc-Ex-001"/>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" image="LaunchStripExtensionTop" translatesAutoresizingMaskIntoConstraints="NO" id="LSc-Ex-002"/>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" image="LaunchLogo" translatesAutoresizingMaskIntoConstraints="NO" id="LSc-Lg-001">
                                <constraints>
                                    <constraint firstAttribute="width" secondItem="LSc-Lg-001" secondAttribute="height" multiplier="1" id="LSc-Cn-001"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="LSc-Bg-001" firstAttribute="top" secondItem="LSc-Vw-001" secondAttribute="top" id="LSc-Cn-002"/>
                            <constraint firstItem="LSc-Bg-001" firstAttribute="bottom" secondItem="LSc-Vw-001" secondAttribute="bottom" id="LSc-Cn-003"/>
                            <constraint firstItem="LSc-Bg-001" firstAttribute="leading" secondItem="LSc-Vw-001" secondAttribute="leading" id="LSc-Cn-004"/>
                            <constraint firstItem="LSc-Bg-001" firstAttribute="trailing" secondItem="LSc-Vw-001" secondAttribute="trailing" id="LSc-Cn-005"/>
                            <constraint firstItem="LSc-Lg-001" firstAttribute="centerY" secondItem="LSc-Vw-001" secondAttribute="centerY" id="LSc-Cn-006"/>
                            <constraint firstItem="LSc-Lg-001" firstAttribute="leading" secondItem="LSc-Vw-001" secondAttribute="leading" id="LSc-Cn-007"/>
                            <constraint firstItem="LSc-Lg-001" firstAttribute="trailing" secondItem="LSc-Vw-001" secondAttribute="trailing" id="LSc-Cn-008"/>
                            <constraint firstItem="LSc-Ex-001" firstAttribute="top" secondItem="LSc-Lg-001" secondAttribute="bottom" id="LSc-Cn-009"/>
                            <constraint firstItem="LSc-Ex-001" firstAttribute="bottom" secondItem="LSc-Vw-001" secondAttribute="bottom" id="LSc-Cn-010"/>
                            <constraint firstItem="LSc-Ex-001" firstAttribute="width" secondItem="LSc-Vw-001" secondAttribute="width" multiplier="0.15625" id="LSc-Cn-011"/>
                            <constraint firstItem="LSc-Ex-001" firstAttribute="centerX" secondItem="LSc-Vw-001" secondAttribute="centerX" multiplier="0.5859375" id="LSc-Cn-012"/>
                            <constraint firstItem="LSc-Ex-002" firstAttribute="top" secondItem="LSc-Vw-001" secondAttribute="top" id="LSc-Cn-013"/>
                            <constraint firstItem="LSc-Ex-002" firstAttribute="bottom" secondItem="LSc-Lg-001" secondAttribute="top" id="LSc-Cn-014"/>
                            <constraint firstItem="LSc-Ex-002" firstAttribute="width" secondItem="LSc-Vw-001" secondAttribute="width" multiplier="0.15625" id="LSc-Cn-015"/>
                            <constraint firstItem="LSc-Ex-002" firstAttribute="centerX" secondItem="LSc-Vw-001" secondAttribute="centerX" multiplier="1.4296875" id="LSc-Cn-016"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="LSc-Fr-001" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchBackgroundGradient" width="4" height="1024"/>
        <image name="LaunchLogo" width="1024" height="1024"/>
        <image name="LaunchStripExtension" width="160" height="1"/>
        <image name="LaunchStripExtensionTop" width="160" height="1"/>
        <namedColor name="LaunchBackground">
            <color red="0.247" green="0.553" blue="0.957" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
        </namedColor>
    </resources>
</document>
