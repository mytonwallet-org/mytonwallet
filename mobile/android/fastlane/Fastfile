default_platform(:android)

def env_value(name, fallback = nil)
  value = ENV[name]
  value.nil? || value.empty? ? fallback : value
end

# RC_NUMBER must be a bare integer; anything else (empty, or an API error body that slipped
# through the workflow) is treated as absent so it can never reach the version name or notes.
def rc_ordinal
  n = env_value('RC_NUMBER')
  n.to_s.match?(/\A\d+\z/) ? n : nil
end

# Compact provenance line for the top of the build notes: RC label + version, build time,
# and short commit. On release/* the workflow supplies RC_NUMBER (the Nth store build off the
# branch), so RC builds read "RC 26.7.0-rc.2 ..."; ordinary builds just lead with the version.
def build_meta_line(version)
  rc_number = rc_ordinal
  is_rc = !env_value('IS_RELEASE_CANDIDATE').nil? && !rc_number.nil?
  sha = (env_value('GITHUB_SHA') || '')[0, 7]
  stamp = Time.now.utc.strftime('%Y-%m-%d %H:%M')
  head = is_rc ? "RC #{version}-rc.#{rc_number}" : version
  parts = [head, "#{stamp} UTC"]
  parts << sha unless sha.nil? || sha.empty?
  parts.join(' · ')
end

# fastlane runs the Fastfile's own Ruby from the fastlane folder, but every action from its
# parent, so a single relative path names two different files depending on who reads it. A path
# that crosses that boundary - opened here, then handed to an action - is resolved once, against
# the Android project root, and travels absolute from then on.
$android_dir = File.expand_path('..', __dir__)

def android_path(relative)
  File.expand_path(relative, $android_dir)
end

$variant = env_value('APP_VARIANT', 'mytonwallet').downcase
$variant_config = {
  'mytonwallet' => {
    package_name: 'org.mytonwallet.app',
    firebase_app_id: '1:155616896352:android:2d448728d65b6d277eaa05',
    beta_gradle_task: 'assembleMytonwalletBetaRelease',
    release_gradle_task: 'bundleMytonwalletProdRelease',
    direct_gradle_task: 'assembleMytonwalletProdRelease',
  },
  'gram' => {
    package_name: 'io.gramwallet.app',
    firebase_app_id: '1:155616896352:android:539fe0c1f3fc36fa7eaa05',
    beta_gradle_task: 'assembleGramBetaRelease',
    release_gradle_task: 'bundleGramProdRelease',
    direct_gradle_task: 'assembleGramProdRelease',
  },
}

raise "Unknown APP_VARIANT: #{$variant}" unless $variant_config.key?($variant)

$config = $variant_config[$variant]
$package_name = env_value('ANDROID_PACKAGE_NAME', $config[:package_name])
$firebase_app_id = env_value('ANDROID_FIREBASE_APP_ID', $config[:firebase_app_id])
$firebase_groups = env_value('ANDROID_FIREBASE_GROUPS', 'developers,qa,designers')
$play_json_key_file = android_path(env_value('ANDROID_PLAY_JSON_KEY_FILE', './api-key.json'))
$firebase_service_credentials_file = android_path(env_value('ANDROID_FIREBASE_SERVICE_CREDENTIALS_FILE', './firebase-service-account.json'))
$beta_gradle_task = env_value('ANDROID_BETA_GRADLE_TASK', $config[:beta_gradle_task])
$release_gradle_task = env_value('ANDROID_RELEASE_GRADLE_TASK', $config[:release_gradle_task])
$direct_gradle_task = env_value('ANDROID_DIRECT_GRADLE_TASK', $config[:direct_gradle_task])

puts "$variant: #{$variant}"
puts "$package_name: #{$package_name}"
puts "$firebase_app_id: #{$firebase_app_id}"
puts "$beta_gradle_task: #{$beta_gradle_task}"
puts "$release_gradle_task: #{$release_gradle_task}"
puts "$direct_gradle_task: #{$direct_gradle_task}"

def build_release_notes
  commit_sha = ENV['GITHUB_SHA']
  short_sha = commit_sha&.slice(0, 7)
  commit_subject = `git log -1 --pretty=%s`.strip
  fallback = "#{commit_subject}\n\nCommit: #{short_sha}"

  return fallback if ENV['GH_TOKEN'].nil? || ENV['GH_TOKEN'].empty? || commit_sha.nil?

  pr_number = `gh pr list --search "#{commit_sha}" --state merged --json number --jq '.[0].number // empty'`.strip
  return fallback if pr_number.empty?

  pr_json = `gh pr view #{pr_number} --json title,body`
  return fallback if pr_json.nil? || pr_json.empty?

  require 'json'
  pr = JSON.parse(pr_json) rescue nil
  return fallback if pr.nil?

  "#{pr['title']} (##{pr_number})\n\n#{pr['body']}\n\nCommit: #{short_sha}"
rescue StandardError
  "#{`git log -1 --pretty=%s`.strip}\n\nCommit: #{ENV['GITHUB_SHA']&.slice(0, 7)}"
end

def signing_properties
  {
    "android.injected.signing.store.file" => $keystore_path,
    "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
    "android.injected.signing.key.alias" => "key0",
    "android.injected.signing.key.password" => ENV["ANDROID_KEYSTORE_PASSWORD"]
  }
end

def write_apk_output_path
  output_path_file = ENV['ANDROID_APK_OUTPUT_PATH_FILE']
  return if output_path_file.nil? || output_path_file.empty?

  output_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
  return if output_path.nil? || output_path.empty?

  File.write(output_path_file, output_path)
end

def update_version_and_build_number
  require 'json'

  version = JSON.parse(File.read("../../../package.json"))["version"]

  # Version code = the identity of this CI execution plus a fixed offset, so it is monotonic by
  # construction instead of by asking Play what is taken. Play never surrenders a code it has
  # accepted - including into an edit that is never committed, where the code then appears in NO
  # listing, neither in the tracks nor in the artifact library - so any floor derived from what
  # Play reports is a lower bound that eventually collides. Nothing here is looked up, so nothing
  # can be silently out of date. The offset lifts the series clear of every code the packages have
  # already used; the highest was 3077, on org.mytonwallet.app.
  version_code_offset = 4000

  # The identity is the pair (run, attempt), not the run alone. GITHUB_RUN_NUMBER deliberately
  # does not change when a run is re-run, so a job that dies after Play has already accepted the
  # upload - a flake in the steps that follow it, a runner shutting down mid-job - would ask for
  # that same code on every re-run and could never go green again. GITHUB_RUN_ATTEMPT starts at 1
  # and increments per re-run; giving it the last digit lets a re-run mint a code that is fresh
  # and still increasing. Ten attempts is what one run's decade holds, and an eleventh collides
  # with the next run rather than overtaking it.
  attempts_per_run = 10

  # The counter is scoped to the workflow's identity and restarts at 1 if the workflow file is
  # ever renamed; GitHub offers no way to restore it. That would hand Play a code below what it
  # already serves, which Play refuses by complaining that existing users could not upgrade -
  # unreadable unless you already suspect the rename. Fail here instead, where the cause is named.
  run_number_floor = 390

  run_number = env_value('GITHUB_RUN_NUMBER')
  UI.user_error!('GITHUB_RUN_NUMBER is not set - the version code can only be derived in CI') if run_number.nil?
  UI.user_error!("GITHUB_RUN_NUMBER=#{run_number.inspect} is not a bare integer") unless run_number.match?(/\A\d+\z/)
  if run_number.to_i < run_number_floor
    UI.user_error!("GITHUB_RUN_NUMBER=#{run_number} is below the known floor of #{run_number_floor}: the " \
      'workflow run counter has restarted, which is what renaming the workflow file does. The counter ' \
      'cannot be restored, so recovery takes both edits here: raise version_code_offset until the ' \
      'derived version code clears every code Play already holds, and drop run_number_floor to the ' \
      'restarted counter. Raising the offset alone leaves this guard firing on every run.')
  end

  # Required, not defaulted: an absent or empty value would quietly mint the first attempt's version code
  # again, which is the collision this whole derivation exists to avoid.
  run_attempt = env_value('GITHUB_RUN_ATTEMPT')
  UI.user_error!('GITHUB_RUN_ATTEMPT is not set - the version code can only be derived in CI') if run_attempt.nil?
  UI.user_error!("GITHUB_RUN_ATTEMPT=#{run_attempt.inspect} is not a bare integer") unless run_attempt.match?(/\A\d+\z/)
  unless (1..attempts_per_run).cover?(run_attempt.to_i)
    UI.user_error!("GITHUB_RUN_ATTEMPT=#{run_attempt} is outside the #{attempts_per_run} attempts one run's " \
      'version code can hold; dispatch a fresh run instead of re-running this one again.')
  end

  build_number = version_code_offset + run_number.to_i * attempts_per_run + (run_attempt.to_i - 1)
  UI.message("Android version code: #{version_code_offset} + run #{run_number} * #{attempts_per_run} " \
    "+ (attempt #{run_attempt} - 1) = #{build_number}")

  # RC builds carry the -rc.N ordinal in the version name so they stand out in the Firebase
  # list among the daily *.beta builds (the beta flavor still appends its own .beta suffix).
  rc_number = rc_ordinal
  version_name = (env_value('IS_RELEASE_CANDIDATE').nil? || rc_number.nil?) ? version : "#{version}-rc.#{rc_number}"
  android_set_version_name(version_name: version_name)
  android_set_version_code(version_code: build_number)
end

platform :android do
  desc "Deploy a new Beta Build to the Google Play"

  $gradle_data = nil

  before_all do |lane|
    $gradle_data = File.read("../app/build.gradle")
  end

  $keystore_path = android_path('./android.keystore')

  lane :beta do
    update_version_and_build_number

    gradle(
      task: $beta_gradle_task,
      properties: signing_properties
    )

    release_notes = build_release_notes

    # Prepend the compact provenance line to the Firebase notes so a tester can pin down the
    # exact build (RC ordinal, build time, commit). Applies to every build; RC builds lead
    # with the RC label and go to the same tester groups as any other build.
    version = JSON.parse(File.read("../../../package.json"))["version"]
    release_notes = "#{build_meta_line(version)}\n\n#{release_notes}"

    firebase_app_distribution(
      app: $firebase_app_id,
      android_artifact_type: "APK",
      android_artifact_path: lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH],
      service_credentials_file: $firebase_service_credentials_file,
      release_notes: release_notes,
      groups: $firebase_groups
    )
  end

  desc "Release a new version to the Google Play"
  lane :release do
    # Validate before the build: a malformed value would otherwise surface only at
    # upload time, after the whole Gradle build. Play accepts a userFraction strictly
    # between 0 and 1, and a full rollout is not the fraction 1.0 - it is a `completed`
    # release carrying no fraction at all. So `full` is its own mode rather than a number,
    # and a hotfix that has to reach everyone at once still has a way out of the staged path.
    rollout = env_value("ANDROID_ROLLOUT", "0.1")
    full_rollout = rollout == "full"
    rollout_fraction = full_rollout ? nil : Float(rollout, exception: false)
    if !full_rollout && (rollout_fraction.nil? || rollout_fraction <= 0 || rollout_fraction >= 1)
      UI.user_error!("ANDROID_ROLLOUT must be `full` or a fraction strictly between 0 and 1, got #{rollout.inspect}")
    end

    update_version_and_build_number

    gradle(task: "clean")
    gradle(
      task: $release_gradle_task,
      properties: signing_properties
    )

    # Submit as a staged rollout: the percentage is frozen into the release at submit
    # time and cannot be changed while the change sits approved in the managed-publishing
    # queue, so a "completed" submit leaves no way to roll out gradually. Increasing the
    # fraction of a live staged release is a regular post-publish operation.
    play_store_options = {
      package_name: $package_name,
      json_key: $play_json_key_file,
      track: "production",
      skip_upload_apk: true,
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
    }

    if full_rollout
      play_store_options[:release_status] = "completed"
    else
      play_store_options[:release_status] = "inProgress"
      play_store_options[:rollout] = rollout_fraction.to_s
    end

    upload_to_play_store(play_store_options)
  end

  lane :direct do
    update_version_and_build_number

    # The version code counts this repository's workflow runs, and the repository that publishes
    # runs a far slower counter than the one used for day-to-day builds. A prod-flavor APK from
    # here therefore carries a code the published build cannot exceed, and Android refuses to
    # install a lower code over a higher one for the same package.
    UI.important("Direct APK version code is scoped to #{env_value('GITHUB_REPOSITORY', 'this repository')}; " \
      'a published build installs over it only after an uninstall')

    gradle(
      task: $direct_gradle_task,
      properties: signing_properties
    )

    write_apk_output_path
  end

  after_all do |lane|
    File.write("../app/build.gradle", $gradle_data)
  end

  error do |lane, exception|
    File.write("../app/build.gradle", $gradle_data)
  end
end
