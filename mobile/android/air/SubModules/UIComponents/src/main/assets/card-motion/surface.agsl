// Active branches of CardBackgroundMotion.metal, fc251ae9; sRGB Canvas target.
uniform shader artwork;
uniform shader firstSpot;
uniform shader secondSpot;
uniform shader thirdSpot;
uniform shader brush;
uniform shader touchSpot;
uniform float2 size;
uniform float2 artSize;
uniform float density;
uniform float time;
uniform float strength;
uniform float seed;
uniform float blobTime;
uniform int blobCount;
uniform float contrastOpacity;
uniform float contrastColor;
uniform float brushStrength;
uniform float shine;
uniform float2 touchPosition;
uniform float touchOpacity;
uniform float touchExtent;
uniform int customSurface;
uniform int shineStyle;
uniform int materialPreset;
uniform int materialEnvironment;
uniform float materialIntensity;
uniform float materialBevel;
uniform float materialEmboss;
uniform float materialDepth;
uniform float2 materialTilt;
uniform float gramAngle;
uniform float gramEnergy;
float sat(float v) { return clamp(v,0.0,1.0); }
float3 sat(float3 v) { return clamp(v,0.0,1.0); }
float3 linear(float3 c) { return float3(c.r<=.04045?c.r/12.92:pow((c.r+.055)/1.055,2.4),c.g<=.04045?c.g/12.92:pow((c.g+.055)/1.055,2.4),c.b<=.04045?c.b/12.92:pow((c.b+.055)/1.055,2.4)); }
float3 encoded(float3 c) { return float3(c.r<=.0031308?c.r*12.92:1.055*pow(max(0.0,c.r),1.0/2.4)-.055,c.g<=.0031308?c.g*12.92:1.055*pow(max(0.0,c.g),1.0/2.4)-.055,c.b<=.0031308?c.b*12.92:1.055*pow(max(0.0,c.b),1.0/2.4)-.055); }
float2 motionPosition(float2 uv) {
    if (strength == 0.0) return uv;
    float2 edge=sin(3.14159265359*clamp(uv,0.0,1.0));
    float phase=seed*6.28318530718;
    float2 wave=float2(sin(time*.7+uv.y*5.0+phase)-sin(uv.y*5.0+phase),sin(time*.53+uv.x*4.0+phase)-sin(uv.x*4.0+phase));
    return uv+wave*edge.x*edge.y*strength/400.0;
}
float3 cardCrystalArtwork(float2 uv) { return linear(float3(artwork.eval(motionPosition(uv)*artSize).rgb)); }
float4 cardCrystalSurface(float2 uv) {
    float2 p = uv * float2(370, 215);
    float y = uv.y;
    float outerLeft = -60 + 61.250004 * y;
    float outerRight = 430.000031 - 61.250031 * y;
    float innerLeft = 1 + 61.333332 * y;
    float innerRight = 369 - 61.333344 * y;
    float wingLeft = 62.000008 + 61.499996 * y;
    float wingRight = 307 - 61 * y;
    // Fragment derivatives keep the exact vector edges smooth at every card size/tilt.
    float aa = max((370.0 / size.x + 0.3 * 215.0 / size.y) / density, 0.25);
    float outer = smoothstep(-aa, aa, min(p.x - outerLeft, outerRight - p.x));
    float inner = smoothstep(-aa, aa, min(p.x - innerLeft, innerRight - p.x));
    float leftWing = smoothstep(-aa, aa, min(p.x - wingLeft, 185 - p.x));
    float rightWing = smoothstep(-aa, aa, min(p.x - 185, wingRight - p.x));
    float side = mix(-1.0, 1.0, smoothstep(185 - aa, 185 + aa, p.x));
    float2 slope = float2(side * 0.32, 0.12);
    slope = mix(slope, float2(-side * 0.18, -0.10), outer);
    slope = mix(slope, float2(side * 0.12, 0.14), inner);
    slope = mix(slope, float2(0.29, -0.09), leftWing);
    slope = mix(slope, float2(-0.26, 0.07), rightWing);
    float edgeDistance = min(min(abs(p.x - innerLeft), abs(p.x - innerRight)),
                            min(min(abs(p.x - wingLeft), abs(p.x - wingRight)), abs(p.x - 185)));
    return float4(normalize(float3(slope, 1)), exp(-edgeDistance / max(0.7, aa)));
}
float3 cardMaterial(float2 uv, float3 base) {
    float2 step = float2(1.0/400, 1.0/232);
    float3 weights = float3(0.2126, 0.7152, 0.0722);
    float dx = dot(cardCrystalArtwork(uv + float2(step.x,0)) - cardCrystalArtwork(uv - float2(step.x,0)),weights);
    float dy = dot(cardCrystalArtwork(uv + float2(0,step.y)) - cardCrystalArtwork(uv - float2(0,step.y)),weights);
    float4 crystal = cardCrystalSurface(uv);
    float2 slope = (customSurface == 0 && shineStyle == 0) ? crystal.xy * 0.65 : float2(0);
    slope += clamp(float2(-dx,-dy) * (1.5 + materialEmboss * 8), -0.35, 0.35);
    float3 normal = normalize(float3(slope, 1));
    float3 view = normalize(float3(materialTilt * 0.65 - (uv-0.5)*float2(0.3,0.18), 1.4));
    float3 reflection = reflect(-view, normal);
    float2 r = reflection.xy;
    float roughness = materialPreset == 0 ? 0.28 : (materialPreset == 1 ? 0.055 : 0.14);
    float3 a = float3(0.78,0.89,1.0), b = float3(1.0,0.94,0.83), c = float3(0.62,0.79,1.0);
    if (materialEnvironment == 1) { a=float3(1,0.59,0.24); b=float3(1,0.83,0.52); c=float3(0.60,0.32,0.48); }
    if (materialEnvironment == 2) { a=float3(0.18,0.93,1); b=float3(1,0.18,0.67); c=float3(0.48,0.27,1); }
    float2 q1 = (r-float2(-0.25,0.24))/float2(roughness,0.55);
    float2 q2 = (r-float2(0.34,-0.12))/float2(roughness*0.75,0.44);
    float2 q3 = (r-float2(-0.04,-0.42))/float2(0.58,roughness);
    float3 radiance = a*exp(-dot(q1,q1)*1.7) + b*exp(-dot(q2,q2)*1.7)*0.75 + c*exp(-dot(q3,q3)*1.7)*0.55;
    if (materialPreset == 2) {
        float film = dot(normal,view)*10 + dot(r,float2(3,-2));
        float3 pearl = 0.5 + 0.5*cos(film+float3(0,2.094,4.189));
        radiance = radiance*0.7 + pearl*0.18;
    }
    float fresnel = pow(1-sat(dot(normal,view)),3);
    float3 result = 1-(1-sat(base))*exp(-radiance*materialIntensity*(0.5+fresnel*2));
    // Thin rounded perimeter and internal facet/print edges, never a full-card wash.
    float2 point = uv*float2(400,232);
    float2 q = abs(point-float2(200,116))-float2(174,90);
    float sdf = length(max(q,0.0))+min(max(q.x,q.y),0.0)-26;
    float edge = exp(-pow((sdf+1.2)/0.8,2.0));
    float inner = (customSurface == 0 && shineStyle == 0) ? crystal.w : sat(length(float2(dx,dy))*5);
    float directional = 0.25+0.75*sat(dot(normalize((uv-0.5)+float2(0.0001)), normalize(materialTilt+float2(0.2,-0.6))));
    result += (1-result) * (edge*directional + inner*max(radiance.r,max(radiance.g,radiance.b))*0.4) * materialBevel;
    float relief = dot(float2(dx,dy),normalize(materialTilt+float2(-0.4,-0.6)))*materialEmboss*1.8;
    result += relief*(relief>0 ? 1-result : result);
    return sat(result);
}

float cardTelegramLightField(float2 uv) {
    float aspect = size.y / max(size.x, 1.0);
    float2 position = float2((uv.x - 0.5) * 2.0, (0.5 - uv.y) * 2.0 * aspect);
    float radius = length(position);
    float2 radial = radius > 0.0001 ? position / radius : float2(1.0, 0.0);
    float2 tangent = float2(-radial.y, radial.x);
    float2 idleDirection = normalize(float2(1.0, -aspect));
    float2 perpendicular = float2(-idleDirection.y, idleDirection.x);
    // CardSurfaceLight already carries normalized and smoothed screen tilt.
    // Convert UIKit's downward Y into the material's upward Y.
    float angle=gramAngle;
    float c = cos(angle), s = sin(angle);
    float2 keyDirection = float2(idleDirection.x * c - idleDirection.y * s,
                                idleDirection.x * s + idleDirection.y * c);
    float alignment = dot(tangent, keyDirection);
    // At 120 degrees / 18pt, use Telegram's roughness 0.20 profile exactly.
    float widthScale = 120.0 / 120.0;
    float blur = 18.0;
    float baseWidth = mix(0.30, 0.44, (0.20 - 0.13) / 0.17) * widthScale;
    float extraBlur = max(0.0, blur - 18.0) / 180.0;
    float wedgeWidth = sqrt(baseWidth * baseWidth + extraBlur * extraBlur);
    float core = exp(-alignment * alignment / max(2.0 * wedgeWidth * wedgeWidth, 0.0001));
    float haloWidth = wedgeWidth * 1.70;
    float halo = exp(-alignment * alignment / max(2.0 * haloWidth * haloWidth, 0.0001));
    float progress = clamp(radius / 0.275, 0.0, 1.0);
    float curve = progress * progress * progress * (progress * (progress * 6.0 - 15.0) + 10.0);
    float centerFade = mix(0.10, 1.0, curve);
    float haloAmount = mix(0.0, 0.42, min(1.0, blur / 18.0));
    float field = mix(core, halo, haloAmount) * centerFade;
    float lobeBalance = mix(0.72, 1.0, 0.5 + 0.5 * dot(radial, keyDirection));
    // Regularize only the subpixel center, avoiding a directional pinprick.
    float centerAA = smoothstep(0.0, 2.0 / max(size.x, 1.0), radius);
    return mix(0.086, field * lobeBalance, centerAA) * baseWidth / wedgeWidth * gramEnergy;
}


half4 main(float2 position) {
    float2 uv=position/max(size,float2(1.0));
    float envelope=sin(3.14159265359*uv.x)*sin(3.14159265359*uv.y);
    float2 materialUV=uv+materialTilt*materialDepth*.45/max(size,float2(1.0))*envelope;
    float3 srgb=float3(artwork.eval(motionPosition(materialUV)*artSize).rgb);
    float a=blobTime*(.7*6.28318530718/40.0);
    float2 centered=uv*float2(400,232)-float2(200,116);
    float2 spotCoord=float2(cos(a)*centered.x+sin(a)*centered.y,-sin(a)*centered.x+cos(a)*centered.y)+float2(328,244);
    if(blobCount>0) {half4 c=firstSpot.eval(spotCoord);srgb=float3(c.rgb)+srgb*(1.0-c.a);}
    if(blobCount>1) {half4 c=secondSpot.eval(spotCoord);srgb=float3(c.rgb)+srgb*(1.0-c.a);}
    if(blobCount>2) {half4 c=thirdSpot.eval(spotCoord);srgb=float3(c.rgb)+srgb*(1.0-c.a);}
    if(contrastColor>=0.0) {
        float radius=length((uv-.5)*float2(400,232)/float2(269.69,158));
        float alpha=radius<.25?1.0-radius*.8:radius<.75?1.1-radius*1.2:max(0.0,.8-radius*.8);
        float3 upper=1.0-2.0*(1.0-srgb)*(1.0-contrastColor),lower=2.0*srgb*contrastColor;
        float3 overlay=float3(srgb.r<=.5?lower.r:upper.r,srgb.g<=.5?lower.g:upper.g,srgb.b<=.5?lower.b:upper.b);
        srgb=mix(srgb,overlay,alpha*contrastOpacity);
        srgb=mix(srgb,float3(contrastColor),alpha*.16);
    }
    if(brushStrength>0.0) {
        float grain=brush.eval(uv*float2(800,464)).r;
        float3 upper=1.0-2.0*(1.0-srgb)*(1.0-grain),lower=2.0*srgb*grain;
        float3 overlay=float3(srgb.r<=.5?lower.r:upper.r,srgb.g<=.5?lower.g:upper.g,srgb.b<=.5?lower.b:upper.b);
        srgb=mix(srgb,overlay,brushStrength);
    }
    if(shine>0.0) srgb=sat(encoded(linear(srgb)+float3(.090,.565,.965)*cardTelegramLightField(uv)*(0.32/0.24)*shine));
    if(touchOpacity>0.0) {
        float2 p=(uv-.5)*size-touchPosition*size*.5;
        float field=touchSpot.eval((p/touchExtent+.5)*512.0).a;
        srgb=sat(srgb+field*touchOpacity);
    }
    srgb=cardMaterial(uv,srgb);
    return half4(half3(srgb),1.0);
}
