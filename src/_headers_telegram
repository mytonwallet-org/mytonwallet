# This file is for tma.mywallet.io hosted on Netlify
/
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
# Every path serves the app through the rewrite in `_redirects`, so framing is restricted on all of them. The rest of
# the policy reaches the page through its `<meta>` tag, because as a header it would also bind the workers.
/*
  Content-Security-Policy: {{FRAME_ANCESTORS}}
  X-Robots-Tag: noindex
